---
import HeartIcon from "@/assets/heart.svg"
import { getCollection } from "astro:content"

const healthcares = await getCollection("healthcares")

---

<div id="products" class="pb-16 pt-16">
  <h2 class="text-[#7c6a0a] text-3xl font-light pb-16">Cuidado de la salud</h2>
  <div class="grid lg:grid-cols-4 md:grid-cols-3 grid-cols  gap-4 pb-8">
   {
    healthcares.map((healthcare)=>{
      const {slug,data} = healthcare
      const {title,description,img,price} = data
      const formattedPrice = new Intl.NumberFormat("es-PE",{
        style:"currency",
        currency: "PEN",
        minimumFractionDigits:2
      }).format(price)

      return(
      <article class="w-full flex-wrap p-6 bg-[#ffdac6] text-[#7c6a0a] rounded-lg ">
        <a href="#" class="flex justify-end items-center pb-2 cursor-pointer">
          <HeartIcon class="size-6"/>
        </a>
        <a href={`/healthcare/${slug}`}>
          <figure class="pb-4">
            <img
              transition:name={`img-${slug}`}
              src={`/${img}`}
              class="aspect-square rounded-lg"
              alt={title} />
          </figure>
        </a>
        <a href={`/healthcare/${slug}`} class="text-lg font-bold pt-4">{title}</a>
        <p >{description}</p>
        <span class="font-light text-lg text-[#7c6a0a]">{formattedPrice}</span>
      </article>
      )
    })
   }
  </div>
</div>
