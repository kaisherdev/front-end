---
import CartIcon from "@/assets/cart.svg"
import ProfileIcon from "@/assets/profile.svg"
import HeartIcon from "@/assets/heart.svg"
import HamburgerIcon from "@/assets/icons/Hamburger.astro"
import CloseIcon from "@/assets/icons/Close.astro"

const navItems = [
  {
    "title":"Nosotros",
    "label":"nosotros",
    "url":"/#about-us"
  },
  {
    "title":"Cuidado de salud",
    "label":"productos",
    "url":"/#products"
  },
  {
    "title":"Mobiliario",
    "label":"mobiliario",
    "url":"/#furniture"
  }
]
---

<header class="w-full fixed top-0 z-20">
  <nav class="max-w-5xl lg:mx-auto h-16 flex justify-between items-center gap-4 mx-4 text-[#7c60a]">
    <a href="/" class="lg:text-3xl text-2xl font-light">Eco Store</a>
    <div class="text-lg font-medium">
      <ul class="hidden lg:flex justify-between items-center gap-8">
      {
        navItems.map(({title, label, url})=>(
        <li class="p-1">
          <a
            href={url}
            aria-label={label}
            class="hover:border-b hover:text-[#7c6a0a] ">
            {title}
          </a>
        </li>
        ))
      }
      </ul>
    </div>
    <div class="icons flex gap-2">
      <a href="#" class="profile">
        <ProfileIcon class="size-6"/>
      </a>
      <a href="#" class="wishlist">
        <HeartIcon class="size-6"/>
      </a>
      <a href="#" class="cart">
       <CartIcon class="size-6"/>
      </a>
    </div>
    <div class="flex lg:hidden">
      <button id="open-menu-button" type="button" class="cursor-pointer">
        <span class="sr-only">Abri menú</span>
        <HamburgerIcon/>
      </button>
    </div>
  </nav>

  <dialog
    id="mobile-menu"
    role="dialog"
    aria-modal="true"
    class="transition-(display) bg-[#7c6a0a] lg:hidden size-full max-h-full max-w-full p-4 translate-x-0 transform transition-all ease-in-out duration-300 starting:-translate-x-full [&:not([open])]:-translate-x-full z-40">
    <div class="overflow-y-auto z-10">
      <div>
      <div class="flex flex-1">
        <button
          type="button"
          id="close-menu-button"
          class="cursor-pointer text-white transition-all duration-300 ease-in will-change-transform hover:scale-150">
          <span class="sr-only">Cerrar menú</span>
          <CloseIcon/>
        </button>
      </div>
    </div>
    </div>

    <div class="flex flex-col items-center justify-center" >
      <ul class="flex flex-col lg:flex-row lg:gap-3">
        {
          navItems.map(({ title, url, label }) => (
            <>
              <li>
                <a
                  href={url}
                  aria-label={label}
                  class="flex lg:px-3 py-2 items-center justify-center text-slate-200 text-lg hover:text-gray-900">
                  <span class="font-bold"> {title}</span>
                </a>
              </li>
            </>
          ))
        }
      </ul>
    </div>
  </dialog>
</header>

<style>
  header{
    background: transparent;
    animation:  header-blur-scroll 0.3s linear both;
    animation-timeline: scroll();
    animation-range: 0 250px;
    border-bottom: 1px solid transparent;
  }

  @keyframes header-blur-scroll{
    0%{
      backdrop-filter: blur(0px);
      background: transparent;
    }
    100%{
      backdrop-filter: blur(10px);
      background: rgb(186, 189, 141,1);
      border-bottom-color: #7c6a0a;
      color: white;
    }
  }
</style>

<script>
const mobileMenu = document.getElementById("mobile-menu") as HTMLDialogElement
 const openMenuButton = document.getElementById("open-menu-button")
 const closeMenuButton = document.getElementById("close-menu-button")
 const mobileItems = mobileMenu.querySelectorAll("a")

 const toggleMenu = () => {
	 mobileMenu.open ? mobileMenu.close() : mobileMenu.showModal()
 }

 openMenuButton?.addEventListener("click", toggleMenu)

 closeMenuButton?.addEventListener("click", toggleMenu)

 document.addEventListener("click", (event) => {
	 const isClickInsideMenu = mobileMenu.contains(event.target as Node)
	 const isClickInsideButton = openMenuButton?.contains(event.target as Node)

	 if (isClickInsideMenu && !isClickInsideButton) {
		 mobileMenu.close()
	 }
 })

 mobileItems?.forEach((item) => item.addEventListener("click", toggleMenu))
</script>
