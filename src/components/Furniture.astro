---
import { getCollection } from "astro:content";
import HeartIcon from "@/assets/heart.svg";

const furnitures = await getCollection("furnitures")

---

<div id="furniture">
  <h2 class="text-[#7c6a0a] text-3xl font-light pb-16">Decoración del hogar</h2>
  <div class="grid lg:grid-cols-4 md:grid-cols-3 grid-cols-1 gap-4 pb-8">
    {
      furnitures.map((furniture)=>{
        const {slug,data}= furniture;
        const {title,img,price,description} = data;
        const formattedPrice = new Intl.NumberFormat("es-PE", {
          style: "currency",
          currency: "PEN",
          minimumFractionDigits: 2
        }).format(price);

        return(
          <article class="w-full bg-[#babd8d] text-white rounded-lg p-6">
            <a href="#" class="flex justify-end items-center pb-2 cursor-pointer">
              <HeartIcon class="size-6" />
            </a>
            <a href={`/furniture/${slug}`}>
              <figure class="pb-4">
                <img
                  transition:name={`img-${slug}`}
                  src={`/${img}`}
                  class="aspect-square rounded-lg"
                  alt={title}/>
              </figure>
            </a>
            <a href={`/furniture/${slug}`} class="text-lg font-bold">{title}</a>
            <p class="pb-2 text-sm">{description}</p>
            <span class="font-light text-lg text-[#7c6a0a]"> {formattedPrice}</span>
          </article>
        )
      })
    }
  </div>
</div>
