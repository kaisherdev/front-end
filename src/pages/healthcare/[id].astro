---
import { render,getCollection } from "astro:content";

import Layout from "@/layouts/Layout.astro";
import CartIcon from "@/assets/cart.svg";

export async function getStaticPaths() {

  const healthcares = await getCollection("healthcares");

  return healthcares.map((healthcare)=>({
    params: {id:healthcare.slug},
    props: {healthcare},
  }));
}

const {healthcare} = Astro.props
const {slug,data} = healthcare
const {title,img,price} = data

const formattedPrice = new Intl.NumberFormat("es-PE",
{
  style: "currency",
  currency: "PEN",
  minimumFractionDigits:2
}).format(price)

const {Content} = await render(healthcare)

export const prerender = true
---

<Layout
  title={`${title} - Eco-Store`}
  description="Encuentra productos para el cuidado de la salud hechos artesanalmente y con insumos naturales.">
<div class="lg:flex justify-between gap-8 pt-24 ">
  <aside class="flex flex-col gap-4 lg:w-1/2">
    <img
      transition:name={`img-${slug}`}
      src={`/${img}`}
      class=" aspect-square rounded-lg"
      alt={title}/>
  </aside>
  <main class="lg:w-1/2 lg:pt-0 pt-4">
    <div class="flex flex-col pb-4">
      <h1 class="text-[#7c6a0a] font-bold text-4xl pb-4">{title}</h1>
      <span class="font-light text-2xl text-[#7c6a0a] pb-4">{formattedPrice}</span>
      <span>⭐⭐⭐⭐⭐</span>
    </div>
    <div class="prose prose-invert pb-4 w-full">
      <Content/>
    </div>
    <div class="flex justify-between items-center gap-4">
      <button type="button" class="px-4 py-1.5 bg-blue-500 rounded-lg text-white disabled flex items-center gap-2">
        <CartIcon class="size-6"/>
        Agregar
      </button>
      <a href="/#products" class="hover:underline opacity-70">
        ⬅ Volver al inicio
      </a>
    </div>
  </main>
</div>
</Layout>
