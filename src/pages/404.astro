---
import Layout from "@/layouts/Layout.astro";
---

<Layout
	title="Página no encontrada - Kaisher Dev"
	description="Soy profesional en computación e informática. Contactame si necesitas hacer tu página web.">

	<main class="grid min-h-full place-items-center px-6 py-24 sm:py-32 lg:px-8">
  <div class="max-w-lg text-center">
    <p class="text-6xl font-bold">404</p>
    <h1 class="mt-4 text-3xl font-semibold tracking-tight text-balance sm:text-5xl text-[#7c6a0a]">
			Página no encontrada
		</h1>
    <p class="mt-6 text-lg font-medium text-balance text-[#7c6a0a] sm:text-xl/8">
			¿Hola! Lo siento, no pudimos encontrar la página que estabas buscando. Verifica la URL e intenta de nuevo.
		</p>
    <div class="mt-10 lg:flex flex-col items-center justify-center gap-x-6">
      <a href="/" class="bg-[#fa9500] hover:bg-orange-200 rounded-full text-white hover:text-[#7c6a0a] text-lg transform hover:scale-105 hover:border hover:border-[#7c6a0a] duration-300 px-4 py-1.5">
        Ir al inicio
      </a>
      <a href="mailto:kaisher.dev.wese872@passinbox.com" class="text-sm font-semibold hover:text-[#7c6a0a] ">
				Contactactar con soporte
				<span aria-hidden="true">&rarr;</span>
			</a>
    </div>
  </div>
</main>
</Layout>
