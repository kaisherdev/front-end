---
import { render,getCollection } from "astro:content";

import Layout from "@/layouts/Layout.astro";
import CartIcon from "@/assets/cart.svg";


export async function getStaticPaths() {

  const furnitures = await getCollection("furnitures");

  return furnitures.map((furniture)=>({
    params: {id:furniture.slug},
    props: {furniture},
  }));
}

const {furniture} = Astro.props
const {slug,data} = furniture
const {title,img,price} = data

const formattedPrice = new Intl.NumberFormat("es-PE",
{
  style: "currency",
  currency: "PEN",
  minimumFractionDigits:2
}).format(price)

const {Content} = await render(furniture)

export const prerender = true
---

<Layout
  title={`${title} - Eco-Store`}
  description="Encuentra mobiliarios hechos totalmente con insumos amigables para el medio ambinete.">

<div class="lg:flex justify-between gap-8 pt-24  ">
  <aside class="flex flex-col lg:w-1/2 gap-4">
    <img
      transition:name={`img-${slug}`}
      src={`/${img}`}
      class="aspect-square rounded-lg"
      alt={title}/>
  </aside>
  <main class="lg:w-1/2 lg:pt-0 pt-4">
    <div class="flex flex-col pb-4">
      <h1 class="text-[#7c6a0a] font-bold text-4xl pb-4">{title}</h1>
      <span class="font-light text-2xl text-[#7c6a0a] pb-4">{formattedPrice}</span>
      <span>⭐⭐⭐⭐⭐</span>
    </div>
    <div class="prose prose-invert pb-4 text-balance">
      <Content/>
    </div>
    <div class="flex gap-4 justify-between items-center">
      <button type="button" class="px-4 py-1.5 bg-blue-500 rounded-lg text-white flex gap-2 items-center"><CartIcon class="size-6"/> Agregar</button>
      <a href="/#furniture" class="hover:underline opacity-70">⬅ Volver al inicio</a>
    </div>
  </main>
</div>
</Layout>
